003e\u003cspan class=\"pl-pds\"\u003e\u0026quot;\u003c/span\u003e\u003c/span\u003e,","    \u003cspan class=\"pl-s\"\u003e\u003cspan class=\"pl-pds\"\u003e\u0026quot;\u003c/span\u003edf[\u0026#39;confidence_classes\u0026#39;] = pd.cut(df[\u0026#39;confidence\u0026#39;], bins=bins, labels=labels, include_lowest=True)\u003cspan class=\"pl-cce\"\u003e\\n\u003c/span\u003e\u003cspan class=\"pl-pds\"\u003e\u0026quot;\u003c/span\u003e\u003c/span\u003e,","    \u003cspan class=\"pl-s\"\u003e\u003cspan class=\"pl-pds\"\u003e\u0026quot;\u003c/span\u003e\u003cspan class=\"pl-cce\"\u003e\\n\u003c/span\u003e\u003cspan class=\"pl-pds\"\u003e\u0026quot;\u003c/span\u003e\u003c/span\u003e,","    \u003cspan class=\"pl-s\"\u003e\u003cspan class=\"pl-pds\"\u003e\u0026quot;\u003c/span\u003emeta_fc_df=df[df[\u0026#39;full_confidence\u0026#39;]]\u003cspan class=\"pl-cce\"\u003e\\n\u003c/span\u003e\u003cspan class=\"pl-pds\"\u003e\u0026quot;\u003c/span\u003e\u003c/span\u003e,","    \u003cspan class=\"pl-s\"\u003e\u003cspan class=\"pl-pds\"\u003e\u0026quot;\u003c/span\u003emeta_fc_df.drop(columns=[\u0026#39;full_confidence\u0026#39;, \u0026#39;confidence_classes\u0026#39;], inplace=True)\u003cspan class=\"pl-cce\"\u003e\\n\u003c/span\u003e\u003cspan class=\"pl-pds\"\u003e\u0026quot;\u003c/span\u003e\u003c/span\u003e,","    \u003cspan class=\"pl-s\"\u003e\u003cspan class=\"pl-pds\"\u003e\u0026quot;\u003c/span\u003emeta_df = copy.deepcopy(df)\u003cspan class=\"pl-cce\"\u003e\\n\u003c/span\u003e\u003cspan class=\"pl-pds\"\u003e\u0026quot;\u003c/span\u003e\u003c/span\u003e,","    \u003cspan class=\"pl-s\"\u003e\u003cspan class=\"pl-pds\"\u003e\u0026quot;\u003c/span\u003esample_fraction = config[\u003cspan class=\"pl-cce\"\u003e\\\u0026quot;\u003c/span\u003epartition_config\u003cspan class=\"pl-cce\"\u003e\\\u0026quot;\u003c/span\u003e][\u003cspan class=\"pl-cce\"\u003e\\\u0026quot;\u003c/span\u003esample_fraction\u003cspan class=\"pl-cce\"\u003e\\\u0026quot;\u003c/span\u003e]\u003cspan class=\"pl